{
  "name": "AdventureWorks Light",
  "dataColors": [
    "#2563C9",
    "#F08A24",
    "#7FA6E3",
    "#12284C",
    "#12805C",
    "#C23B32",
    "#F6B87A",
    "#9AA6B8"
  ],
  "background": "#FFFFFF",
  "secondaryBackground": "#F3F5F9",
  "foreground": "#1B2533",
  "foregroundNeutralSecondary": "#586374",
  "foregroundNeutralTertiary": "#8C97A8",
  "backgroundLight": "#EEF3FB",
  "backgroundNeutral": "#E2E7EF",
  "tableAccent": "#2563C9",
  "good": "#12805C",
  "bad": "#C23B32",
  "neutral": "#F08A24",
  "maximum": "#2563C9",
  "center": "#7FA6E3",
  "minimum": "#E3EDFA",
  "textClasses": {
    "callout": {
      "fontSize": 27,
      "fontFace": "Segoe UI Bold",
      "color": "#1B2533"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Bold",
      "color": "#1B2533"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Bold",
      "color": "#586374"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#3C4757"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E7EF"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 14,
            "bottom": 14,
            "left": 18,
            "right": 18
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1B2533"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Bold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#586374"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#586374"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#586374"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E8ECF2"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#3C4757"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1B2533"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualTooltip": [
          {
            "type": "Default",
            "titleFontColor": {
              "solid": {
                "color": "#586374"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#1B2533"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "border": {
              "solid": {
                "color": "#E2E7EF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#586374"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#1B2533"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#E2E7EF"
