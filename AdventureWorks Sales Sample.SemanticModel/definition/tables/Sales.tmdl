	measure 'KPI Customers Badge' = IF ( ISBLANK ( [Customers YoY %] ), "n/a", FORMAT ( [Customers YoY %], "▲ 0.0%;▼ 0.0%;0.0%" ) )
		displayFolder: 8. Display
		lineageTag: d60a1c73-76ad-4c22-ba9e-3ca16d0cbd43

	measure 'KPI Sales Badge Color' = IF ( [Sales YoY %] < 0, "#C23B32", "#12805C" )
		displayFolder: 8. Display
