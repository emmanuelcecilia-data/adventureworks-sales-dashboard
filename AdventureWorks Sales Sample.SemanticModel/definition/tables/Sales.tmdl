	measure 'KPI Profit Detail' = "margin " & FORMAT ( [Profit Margin %], "0.0%" )
		displayFolder: 8. Display
		lineageTag: 4d5f774f-d791-4ccb-8567-bd03575c91d9

	measure 'KPI Orders Detail' = "AOV " & FORMAT ( [Avg Order Value], "$#,0" )
		displayFolder: 8. Display
		lineageTag: bdacd985-0cf1-4928-bb54-fd3f0f2da502

	measure 'KPI Customers Detail' = FORMAT ( [Active Resellers], "#,0" ) & " resellers"
		displayFolder: 8. Display
		lineageTag: ee928254-22de-4ae5-8232-98eb0750ac73

	measure 'Insight 1 Text' =
			VAR SalesM = FORMAT ( [Total Sales] / 1000000, "$#,0.0" ) & "M"
			RETURN
			    IF (
			        ISBLANK ( [Sales PY] ),
			        "Total sales reached " & SalesM & ". The strongest month was " & [Best Month] & ".",
			        "Sales are " & [Sales Direction] & " " & FORMAT ( [Sales YoY Abs %], "0.0%" )
			            & " on last year, reaching " & SalesM & ". The strongest month was " & [Best Month] & "."
			    )
		displayFolder: 8. Display
		lineageTag: 5fa7e23c-8b09-4706-a2c2-7495f65bc925

	measure 'Insight 2 Text' =
			[Top Category] & " bring in " & FORMAT ( [Top Category Share], "0%" ) & " of revenue, while "
			    & [Best Margin Category] & " earn the best margin at " & FORMAT ( [Best Margin %], "0.0%" ) & "."
		displayFolder: 8. Display
		lineageTag: 2e935501-33f4-49da-81a6-6bf312aba868

	measure 'Insight 3 Text' =
			[Top Country] & " is the largest market with " & FORMAT ( [Top Country Share], "0%" ) & " of sales"
			    & IF (
			        ISBLANK ( [Fastest Country] ),
			        ".",
			        "; " & [Fastest Country] & " grew fastest at " & FORMAT ( [Fastest Country Growth], "+0.0%;-0.0%;0.0%" ) & "."
			    )
		displayFolder: 8. Display
		lineageTag: 452b2381-641d-44d1-bcce-a94207a07aa9

	measure 'Insight 4 Text' =
			IF (
			    ISBLANK ( [Weakest Subcategory] ),
			    "Pick a fiscal year that has a prior year to see what to watch.",
			    IF (
			        [Weakest Subcategory Change] < 0,
			        "Watch: " & [Weakest Subcategory] & " sales fell " & FORMAT ( ABS ( [Weakest Subcategory Change] ), "0.0%" ) & " year on year.",
			        "Slowest grower: " & [Weakest Subcategory] & ", up " & FORMAT ( [Weakest Subcategory Change], "0.0%" ) & " year on year."
			    )
			)
		displayFolder: 8. Display
		lineageTag: a0ece0dc-21fa-424e-8139-95b2652b181d

