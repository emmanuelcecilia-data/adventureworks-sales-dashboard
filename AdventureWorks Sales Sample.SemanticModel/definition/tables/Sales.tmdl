		displayFolder: 8. Display
		lineageTag: b86ea22b-f3a1-4b36-a90a-b71bab3bdf77

	measure 'KPI Sales Badge Fill' = IF ( [Sales YoY %] < 0, "#FDE8E7", "#E3F4EC" )
		displayFolder: 8. Display
		lineageTag: 1b36d2bd-a2a5-43d5-bf8f-50ff1aef57b9

	measure 'KPI Profit Badge Fill' = IF ( [Profit YoY %] < 0, "#FDE8E7", "#E3F4EC" )
		displayFolder: 8. Display
