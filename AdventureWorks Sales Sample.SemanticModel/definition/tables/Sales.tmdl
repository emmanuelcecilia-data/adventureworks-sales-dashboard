	measure 'KPI Orders Value' = FORMAT ( [Total Orders], "#,0" )
		displayFolder: 8. Display
		lineageTag: a7dd24d2-1e57-49a8-b098-ab3b186a6c77

	measure 'KPI Customers Value' = FORMAT ( [Customers], "#,0" )
		displayFolder: 8. Display
		lineageTag: 77b1714d-5df3-4a21-90b7-25e3f0169bbc

	measure 'KPI Sales Badge' = IF ( ISBLANK ( [Sales YoY %] ), "n/a", FORMAT ( [Sales YoY %], "▲ 0.0%;▼ 0.0%;0.0%" ) )
		displayFolder: 8. Display
		lineageTag: 035ed80e-9947-412c-995d-36c51171da9c

	measure 'KPI Profit Badge' = IF ( ISBLANK ( [Profit YoY %] ), "n/a", FORMAT ( [Profit YoY %], "▲ 0.0%;▼ 0.0%;0.0%" ) )
		displayFolder: 8. Display
