table Sales
	lineageTag: 28101f1b-a04b-46dc-b46e-3242c7239dc6

	measure 'Total Sales' = SUM ( Sales[Sales Amount] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1. Sales
		lineageTag: bf0f1648-b93f-49ae-a1ae-2b79ac4bfb6f

	measure 'Total Cost' = SUM ( Sales[Total Product Cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1. Sales
		lineageTag: 4e856fdc-1e3a-440a-ae4f-8e120fb4ec13

	measure Profit = [Total Sales] - [Total Cost]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1. Sales
		lineageTag: bba75f76-dd79-47ff-b6ad-dd811fe73985

	measure 'Profit Margin %' = DIVIDE ( [Profit], [Total Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Sales
		lineageTag: f9eba5d7-fbc6-4576-908b-634ab79d2dd2

	measure 'Total Quantity' = SUM ( Sales[Order Quantity] )
		formatString: #,0
		displayFolder: 1. Sales
		lineageTag: 9f0f1994-8eb1-4bd4-973a-8ba1481750fe

	measure 'Total Orders' = DISTINCTCOUNT ( Sales[Sales Order] )
		formatString: #,0
		displayFolder: 1. Sales
		lineageTag: 2a3463fc-5657-4164-850b-96b67d413080

	measure 'Order Lines' = COUNTROWS ( Sales )
		formatString: #,0
		displayFolder: 1. Sales
		lineageTag: b0f62850-f823-4f6c-86f5-23bca430b8f6

	measure 'Avg Order Value' = DIVIDE ( [Total Sales], [Total Orders] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1. Sales
		lineageTag: ef84d8e8-935d-41c2-adcd-366bc58e1165

	measure 'Avg Selling Price' = DIVIDE ( [Total Sales], [Total Quantity] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1. Sales
		lineageTag: 2cebb1d7-d0ce-4568-a911-ac90e3b1e679

	measure Customers = CALCULATE ( DISTINCTCOUNT ( Sales[CustomerKey] ), KEEPFILTERS ( Sales[CustomerKey] <> -1 ) )
		formatString: #,0
		displayFolder: 2. Customers & Products
		lineageTag: 47ae21b8-5ca4-4b91-a786-966402300a78

	measure 'Active Resellers' = CALCULATE ( DISTINCTCOUNT ( Sales[ResellerKey] ), KEEPFILTERS ( Sales[ResellerKey] <> -1 ) )
		formatString: #,0
		displayFolder: 2. Customers & Products
		lineageTag: 701ed36f-c896-4e5d-995c-108ea34335e3

	measure 'Products Sold' = DISTINCTCOUNT ( Sales[ProductKey] )
		formatString: #,0
		displayFolder: 2. Customers & Products
		lineageTag: 905eb886-2862-46b5-9d56-f8240a5294f5

	measure 'Product Sales Rank' =
			IF (
			    ISINSCOPE ( Product[Product] ),
			    RANKX ( ALLSELECTED ( Product[Product] ), [Total Sales], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: 2. Customers & Products
		lineageTag: 0578f1ff-be56-42ed-853c-02bb8d74aeae

	measure 'Internet Sales' = CALCULATE ( [Total Sales], KEEPFILTERS ( Sales[Channel] = "Internet" ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3. Channel
		lineageTag: caa58785-535e-479e-8802-bc18bf9c543b

	measure 'Reseller Sales' = CALCULATE ( [Total Sales], KEEPFILTERS ( Sales[Channel] = "Reseller" ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3. Channel
		lineageTag: ea9ac940-f3aa-4240-877b-626c4aab0083

	measure 'Internet Sales %' = DIVIDE ( [Internet Sales], [Total Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3. Channel
		lineageTag: 63e3605c-53a5-45cf-86d7-85204352c61b

	measure 'Reseller Sales %' = DIVIDE ( [Reseller Sales], [Total Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3. Channel
		lineageTag: c41bdc8b-c7e5-4b7f-9f6c-517b3691ab6f

	measure 'Sales PY' = IF ( HASONEVALUE ( 'Date'[Fiscal Year] ), CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 4. Time Intelligence
		lineageTag: 88dae29e-d8ac-4b8a-bcc5-1c259a4c9f81

	measure 'Sales YoY' = IF ( NOT ISBLANK ( [Sales PY] ), [Total Sales] - [Sales PY] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 4. Time Intelligence
		lineageTag: 22992e5d-b25e-4729-a23a-3830e23674fa

	measure 'Sales YoY %' = DIVIDE ( [Sales YoY], [Sales PY] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 4. Time Intelligence
		lineageTag: 5b5d4e92-191d-432d-884a-0b7ced75d8f0

	measure 'Sales FYTD' = TOTALYTD ( [Total Sales], 'Date'[Date], "6/30" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 4. Time Intelligence
		lineageTag: 1218b784-7656-4a50-93d1-5c7f21168e70

	measure 'Sales PY FYTD' = CALCULATE ( [Sales FYTD], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 4. Time Intelligence
		lineageTag: b06942be-cf5d-4f46-b090-30698cbb0d1e

	measure 'Sales FYTD YoY %' = DIVIDE ( [Sales FYTD] - [Sales PY FYTD], [Sales PY FYTD] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 4. Time Intelligence
		lineageTag: 070904fc-4f2b-49e6-9cc9-2900da096ead

	measure 'Profit PY' = IF ( HASONEVALUE ( 'Date'[Fiscal Year] ), CALCULATE ( [Profit], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 4. Time Intelligence
		lineageTag: fa8db76d-0507-47b8-9340-c6bc0ee89cf4

	measure 'Profit YoY %' = DIVIDE ( [Profit] - [Profit PY], [Profit PY] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 4. Time Intelligence
		lineageTag: 3dda3755-155e-438e-b2f3-186f9b5213bd

	measure 'Orders PY' = IF ( HASONEVALUE ( 'Date'[Fiscal Year] ), CALCULATE ( [Total Orders], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		formatString: #,0
		displayFolder: 4. Time Intelligence
		lineageTag: aab7437d-3628-4ffc-bada-5fc2391b3a86

	measure 'Orders YoY %' = DIVIDE ( [Total Orders] - [Orders PY], [Orders PY] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 4. Time Intelligence
		lineageTag: e98900f0-ff28-40b8-9387-8f67fe391de2

	measure 'Sales Ship Date' = CALCULATE ( [Total Sales], USERELATIONSHIP ( Sales[ShipDateKey], 'Date'[DateKey] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 4. Time Intelligence
		lineageTag: ef9a7b7a-2e07-48cd-b08d-2ecd82a30dd6

	measure 'Customers PY' = IF ( HASONEVALUE ( 'Date'[Fiscal Year] ), CALCULATE ( [Customers], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		formatString: #,0
		displayFolder: 4. Time Intelligence
		lineageTag: f7c8186f-eadf-4e5d-b9a6-459551be8da6

	measure 'Customers YoY %' = DIVIDE ( [Customers] - [Customers PY], [Customers PY] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 4. Time Intelligence
		lineageTag: 9de30ff9-f0ad-46d2-8dc0-2d138dd2ad67

	measure 'Reseller Sales Rank' =
			IF (
			    ISINSCOPE ( Reseller[Reseller] ),
			    RANKX ( ALLSELECTED ( Reseller[Reseller] ), [Total Sales], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: 2. Customers & Products
		lineageTag: aaf83d87-d360-449b-b2bf-ed057253155b

	measure 'Selected Metric' = SELECTEDVALUE ( 'Metric Selector'[Metric], "Sales" )
		displayFolder: 5. Metric Switch
		lineageTag: 36d6eff1-ac07-4784-9a68-23ebb71c01e2

	measure 'Metric Value' =
			SWITCH (
			    [Selected Metric],
			    "Profit", [Profit],
			    "Orders", [Total Orders],
			    [Total Sales]
			)
		displayFolder: 5. Metric Switch
		lineageTag: ce347624-3043-4d62-af49-5f8edea9d6c0

		formatStringDefinition = IF ( [Selected Metric] = "Orders", "#,0", "$#,0" )

	measure 'Metric Value PY' =
			SWITCH (
			    [Selected Metric],
			    "Profit", [Profit PY],
			    "Orders", [Orders PY],
			    [Sales PY]
			)
		displayFolder: 5. Metric Switch
		lineageTag: 9bd3e4f0-fced-4432-8b45-a26e0a0c51b1

		formatStringDefinition = IF ( [Selected Metric] = "Orders", "#,0", "$#,0" )

	measure 'Metric YoY %' = DIVIDE ( [Metric Value] - [Metric Value PY], [Metric Value PY] )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: 5. Metric Switch
		lineageTag: ede4735c-2e7b-48f5-86b7-9d8dcd11c9cc

	measure 'Selected FY' = SELECTEDVALUE ( 'Date'[Fiscal Year], "All years" )
		displayFolder: 6. Labels
		lineageTag: f023b7d6-c8c7-465a-8b99-faa986d531d8

	measure 'Previous FY' =
			VAR fy = SELECTEDVALUE ( 'Date'[Fiscal Year] )
			RETURN
			    IF ( NOT ISBLANK ( fy ), "FY" & ( VALUE ( RIGHT ( fy, 4 ) ) - 1 ), "prior year" )
		displayFolder: 6. Labels
		lineageTag: 22a2436b-5beb-4548-aa9a-ad3ffa1bfc65

	measure 'Trend Title' = [Selected Metric] & " by Month · " & IF ( HASONEVALUE ( 'Date'[Fiscal Year] ), [Selected FY] & " vs " & [Previous FY], "All years" )
		displayFolder: 6. Labels
		lineageTag: 14e15ae4-4834-4291-9c46-f42e6d42eda6

	measure 'Report Subtitle' =
			VAR Regions =
			    IF (
			        ISFILTERED ( SalesTerritory[Group] ),
			        CONCATENATEX ( VALUES ( SalesTerritory[Group] ), SalesTerritory[Group], ", " ),
			        "All regions"
			    )
			VAR Channels =
			    IF (
			        ISFILTERED ( Sales[Channel] ),
			        CONCATENATEX ( VALUES ( Sales[Channel] ), Sales[Channel], ", " ),
			        "All channels"
			    )
			RETURN
			    [Selected FY] & " · " & Regions & " · " & Channels & " · AdventureWorks Cycles"
		displayFolder: 6. Labels
		lineageTag: 959b16aa-92c7-4bc3-b6ca-add3408fc311

	measure 'Best Month' = MAXX ( TOPN ( 1, VALUES ( 'Date'[Fiscal Month] ), [Total Sales] ), 'Date'[Fiscal Month] )
		displayFolder: 7. Insights
		lineageTag: 7d781973-678c-40fd-964d-f3657ccb030f

	measure 'Sales Direction' = IF ( [Sales YoY %] >= 0, "up", "down" )
		displayFolder: 7. Insights
		lineageTag: 9d31d4d8-9a54-419b-82b5-58c481b4274c

	measure 'Sales YoY Abs %' = ABS ( [Sales YoY %] )
		formatString: 0.0%
		displayFolder: 7. Insights
		lineageTag: ab5d9dac-f1f0-4b95-ac4c-05a0fe5e3ad3

	measure 'Top Category' = MAXX ( TOPN ( 1, VALUES ( Product[Category] ), [Total Sales] ), Product[Category] )
		displayFolder: 7. Insights
		lineageTag: deac906d-101f-4ed9-8b67-877e668b8084

	measure 'Top Category Share' =
			VAR TopCat = [Top Category]
			RETURN
			    DIVIDE (
			        CALCULATE ( [Total Sales], Product[Category] = TopCat ),
			        CALCULATE ( [Total Sales], ALL ( Product[Category] ) )
			    )
		formatString: 0.0%
		displayFolder: 7. Insights
		lineageTag: e76b6a2b-9b7a-49e5-8c34-80400e6ec932

	measure 'Best Margin Category' = MAXX ( TOPN ( 1, VALUES ( Product[Category] ), [Profit Margin %] ), Product[Category] )
		displayFolder: 7. Insights
		lineageTag: a93165c8-3cff-4e27-90dc-430940e26d38

	measure 'Best Margin %' =
			VAR BestCat = [Best Margin Category]
			RETURN
			    CALCULATE ( [Profit Margin %], Product[Category] = BestCat )
		formatString: 0.0%
		displayFolder: 7. Insights
		lineageTag: 806678fd-3b6d-4f41-8c41-da4411cbd9d5

	measure 'Top Country' = MAXX ( TOPN ( 1, VALUES ( SalesTerritory[Country] ), [Total Sales] ), SalesTerritory[Country] )
		displayFolder: 7. Insights
		lineageTag: d5350e75-d288-41ff-884a-b3d82cd231cc

	measure 'Top Country Share' =
			VAR TopCountry = [Top Country]
			RETURN
			    DIVIDE (
			        CALCULATE ( [Total Sales], SalesTerritory[Country] = TopCountry ),
			        CALCULATE ( [Total Sales], ALL ( SalesTerritory[Country] ) )
			    )
		formatString: 0.0%
		displayFolder: 7. Insights
		lineageTag: 0688415e-0f5f-4718-959b-a1f09be93975

	measure 'Fastest Country' =
			MAXX (
			    TOPN (
			        1,
			        FILTER ( VALUES ( SalesTerritory[Country] ), NOT ISBLANK ( [Sales PY] ) ),
			        [Sales YoY %]
			    ),
			    SalesTerritory[Country]
			)
		displayFolder: 7. Insights
		lineageTag: c63cd5ce-a9cd-4bf6-8efb-ec9eaadec8b7

	measure 'Fastest Country Growth' =
			VAR c = [Fastest Country]
			RETURN
			    CALCULATE ( [Sales YoY %], SalesTerritory[Country] = c )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Insights
		lineageTag: 0e7d5725-da61-4d1b-90ae-d9925d6093c4

	measure 'Weakest Subcategory' =
			MINX (
			    TOPN (
			        1,
			        FILTER ( VALUES ( Product[Subcategory] ), NOT ISBLANK ( [Sales PY] ) && NOT ISBLANK ( [Total Sales] ) ),
			        [Sales YoY %], ASC
			    ),
			    Product[Subcategory]
			)
		displayFolder: 7. Insights
		lineageTag: 23f10cfe-f513-4003-9a65-ddbc0986c41c

	measure 'Weakest Subcategory Change' =
			VAR s = [Weakest Subcategory]
			RETURN
			    CALCULATE ( [Sales YoY %], Product[Subcategory] = s )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Insights
		lineageTag: 24f02245-a3f7-40bb-adb1-c320d946ee38

	measure 'KPI Sales Value' = FORMAT ( [Total Sales] / 1000000, "$#,0.00" ) & "M"
		displayFolder: 8. Display
