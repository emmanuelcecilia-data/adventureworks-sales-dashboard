model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Product","Sales","SalesTerritory","Reseller","Date","SalesOrder"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customer
ref table Product
ref table Sales
ref table SalesTerritory
ref table Reseller
ref table Date
ref table SalesOrder
ref table 'Metric Selector'

ref cultureInfo en-US

